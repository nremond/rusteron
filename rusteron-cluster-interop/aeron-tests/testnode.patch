+package io.aeron.test.cluster;
+
+import io.aeron.AeronCounters;
+import io.aeron.Counter;
+import io.aeron.cluster.ConsensusModule;
+import org.agrona.IoUtil;
+import org.agrona.concurrent.status.CountersReader;
+
+import java.io.File;
+import java.io.IOException;
+import java.nio.file.Files;
+import java.time.LocalDateTime;
+import java.time.format.DateTimeFormatter;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.function.Consumer;
+
+/**
+ * rusteron's consensus module, run as a process in place of Java's when the environment variable
+ * {@code AERON_TEST_RUST_CM} names its binary: its settings those the context would have given Java's, its counters
+ * found on the node's media driver and set on the context for the tests to read. Its output goes to
+ * {@code AERON_TEST_RUST_CM_LOG_DIR} when set, which the tests do not clean up, else beside the cluster directory.
+ */
+final class RustConsensusModule implements AutoCloseable
+{
+    static final String BINARY = System.getenv("AERON_TEST_RUST_CM");
+    private static final String LOG_DIR = System.getenv("AERON_TEST_RUST_CM_LOG_DIR");
+    private static final AtomicInteger STARTS = new AtomicInteger();
+
+    private final Process process;
+    private final File log;
+    private final List<Counter> counters = new ArrayList<>();
+    private volatile boolean isClosing;
+
+    static boolean isEnabled()
+    {
+        return null != BINARY && !BINARY.isEmpty();
+    }
+
+    RustConsensusModule(final ConsensusModule.Context ctx, final String aeronDirectoryName, final CountersReader countersReader)
+    {
+        final File clusterDir = ctx.clusterDir();
+        if (ctx.deleteDirOnStart())
+        {
+            IoUtil.delete(clusterDir, true);
+        }
+        IoUtil.ensureDirectoryExists(clusterDir, "cluster");
+        if (null != LOG_DIR && !LOG_DIR.isEmpty())
+        {
+            IoUtil.ensureDirectoryExists(new File(LOG_DIR), "rust consensus module logs");
+            log = new File(LOG_DIR, String.format("%s-%03d-member%d.log",
+                LocalDateTime.now().format(DateTimeFormatter.ofPattern("HHmmss.SSS")), STARTS.incrementAndGet(),
+                ctx.clusterMemberId()));
+        }
+        else
+        {
+            log = new File(clusterDir.getParentFile(), "rust-consensus-module-" + ctx.clusterMemberId() + ".log");
+        }
+
+        final List<String> command = new ArrayList<>();
+        command.add(BINARY);
+        add(command, "--aeron-dir", aeronDirectoryName);
+        add(command, "--cluster-dir", clusterDir.getAbsolutePath());
+        add(command, "--cluster-id", ctx.clusterId());
+        add(command, "--cluster-member-id", ctx.clusterMemberId());
+        add(command, "--cluster-members", ctx.clusterMembers());
+        add(command, "--appointed-leader-id", ctx.appointedLeaderId());
+        add(command, "--service-count", ctx.serviceCount());
+        add(command, "--app-version", ctx.appVersion());
+        add(command, "--file-sync-level", ctx.fileSyncLevel());
+        add(command, "--max-concurrent-sessions", ctx.maxConcurrentSessions());
+        add(command, "--ingress-channel", ctx.ingressChannel());
+        add(command, "--ingress-stream-id", ctx.ingressStreamId());
+        add(command, "--log-channel", ctx.logChannel());
+        add(command, "--log-stream-id", ctx.logStreamId());
+        add(command, "--consensus-channel", ctx.consensusChannel());
+        add(command, "--consensus-stream-id", ctx.consensusStreamId());
+        add(command, "--control-channel", ctx.controlChannel());
+        add(command, "--replication-channel", ctx.replicationChannel());
+        add(command, "--follower-catchup-channel", ctx.followerCatchupChannel());
+        add(command, "--leader-archive-control-channel", ctx.leaderArchiveControlChannel());
+        add(command, "--archive-control-channel", ctx.archiveContext().controlRequestChannel());
+        add(command, "--archive-control-stream-id", ctx.archiveContext().controlRequestStreamId());
+        addNs(command, "--session-timeout", ctx.sessionTimeoutNs());
+        addNs(command, "--leader-heartbeat-timeout", ctx.leaderHeartbeatTimeoutNs());
+        addNs(command, "--leader-heartbeat-interval", ctx.leaderHeartbeatIntervalNs());
+        addNs(command, "--election-timeout", ctx.electionTimeoutNs());
+        addNs(command, "--election-status-interval", ctx.electionStatusIntervalNs());
+        addNs(command, "--startup-canvass-timeout", ctx.startupCanvassTimeoutNs());
+        addNs(command, "--termination-timeout", ctx.terminationTimeoutNs());
+        addNs(command, "--standby-snapshot-notification-delay", ctx.standbySnapshotNotificationProcessingDelayNs());
+        if (ctx.acceptStandbySnapshots())
+        {
+            command.add("--accept-standby-snapshots");
+        }
+        if (null != ctx.clusterClock())
+        {
+            add(command, "--time-unit", switch (ctx.clusterClock().timeUnit())
+            {
+                case MICROSECONDS -> "us";
+                case NANOSECONDS -> "ns";
+                default -> "ms";
+            });
+        }
+
+        try
+        {
+            process = new ProcessBuilder(command)
+                .redirectErrorStream(true)
+                .redirectOutput(ProcessBuilder.Redirect.appendTo(log))
+                .start();
+            awaitReady();
+        }
+        catch (final IOException ex)
+        {
+            throw new IllegalStateException("cannot start " + BINARY, ex);
+        }
+
+        // The module adds its counters through its Aeron client as it starts: on the driver soon after its READY.
+        final int clusterId = ctx.clusterId();
+        final long deadlineNs = System.nanoTime() + TimeUnit.SECONDS.toNanos(10);
+        while (counterId(countersReader, clusterId, AeronCounters.CLUSTER_CONSENSUS_MODULE_STATE_TYPE_ID) < 0 ||
+            counterId(countersReader, clusterId, AeronCounters.CLUSTER_NODE_ROLE_TYPE_ID) < 0 ||
+            counterId(countersReader, clusterId, AeronCounters.CLUSTER_ELECTION_STATE_TYPE_ID) < 0 ||
+            counterId(countersReader, clusterId, AeronCounters.CLUSTER_COMMIT_POSITION_TYPE_ID) < 0)
+        {
+            if (System.nanoTime() > deadlineNs || !process.isAlive())
+            {
+                throw new IllegalStateException("rust consensus module's counters not found, see " + log);
+            }
+            sleep();
+        }
+        find(countersReader, clusterId, AeronCounters.CLUSTER_CONSENSUS_MODULE_STATE_TYPE_ID, ctx::moduleStateCounter);
+        find(countersReader, clusterId, AeronCounters.CLUSTER_NODE_ROLE_TYPE_ID, ctx::clusterNodeRoleCounter);
+        find(countersReader, clusterId, AeronCounters.CLUSTER_CONTROL_TOGGLE_TYPE_ID, ctx::controlToggleCounter);
+        find(countersReader, clusterId, AeronCounters.CLUSTER_COMMIT_POSITION_TYPE_ID, ctx::commitPositionCounter);
+        find(countersReader, clusterId, AeronCounters.CLUSTER_ELECTION_STATE_TYPE_ID, ctx::electionStateCounter);
+        find(countersReader, clusterId, AeronCounters.CLUSTER_ELECTION_COUNT_TYPE_ID, ctx::electionCounter);
+        find(countersReader, clusterId, AeronCounters.CLUSTER_LEADERSHIP_TERM_ID_TYPE_ID, ctx::leadershipTermIdCounter);
+        find(countersReader, clusterId, AeronCounters.CLUSTER_SNAPSHOT_COUNTER_TYPE_ID, ctx::snapshotCounter);
+        find(countersReader, clusterId, AeronCounters.CLUSTER_CLIENT_TIMEOUT_COUNT_TYPE_ID, ctx::timedOutClientCounter);
+        find(countersReader, clusterId, AeronCounters.NODE_CONTROL_TOGGLE_TYPE_ID, ctx::nodeControlToggleCounter);
+        if (ctx.acceptStandbySnapshots())
+        {
+            find(
+                countersReader,
+                clusterId,
+                AeronCounters.CLUSTER_STANDBY_SNAPSHOT_COUNTER_TYPE_ID,
+                ctx::standbySnapshotCounter);
+        }
+        if (null == ctx.errorCounter())
+        {
+            find(countersReader, clusterId, AeronCounters.CLUSTER_CONSENSUS_MODULE_ERROR_COUNT_TYPE_ID, ctx::errorCounter);
+        }
+
+        // Ended on its own, as Java's module ends on a shutdown, an abort or a fatal error: its termination hook
+        // runs, then its counters close, as Java's agent closes them.
+        final Runnable terminationHook = ctx.terminationHook();
+        process.onExit().thenRun(() ->
+        {
+            if (!isClosing)
+            {
+                if (null != terminationHook)
+                {
+                    terminationHook.run();
+                }
+                counters.forEach(Counter::close);
+            }
+        });
+    }
+
+    /**
+     * Stops the process as Java's close stops its agent, without terminating the cluster: SIGTERM, on which it
+     * closes its mark file as Java's does, so that a module started again in its place is not refused. Its counters
+     * are closed as Java's module closes its own, so that the tests read them as closed rather than from a driver
+     * that may be gone.
+     */
+    public void close()
+    {
+        isClosing = true;
+        counters.forEach(Counter::close);
+        process.destroy();
+        try
+        {
+            if (!process.waitFor(10, TimeUnit.SECONDS))
+            {
+                process.destroyForcibly();
+                process.waitFor(10, TimeUnit.SECONDS);
+            }
+        }
+        catch (final InterruptedException ex)
+        {
+            Thread.currentThread().interrupt();
+        }
+    }
+
+    private void awaitReady() throws IOException
+    {
+        final long deadlineNs = System.nanoTime() + TimeUnit.SECONDS.toNanos(30);
+        while (System.nanoTime() < deadlineNs)
+        {
+            final String output = log.exists() ? Files.readString(log.toPath()) : "";
+            if (output.contains("READY"))
+            {
+                return;
+            }
+            if (!process.isAlive())
+            {
+                throw new IllegalStateException("rust consensus module exited " + process.exitValue() + ": " + output);
+            }
+            sleep();
+        }
+        throw new IllegalStateException("rust consensus module not ready, see " + log);
+    }
+
+    private static void sleep()
+    {
+        try
+        {
+            Thread.sleep(10);
+        }
+        catch (final InterruptedException ex)
+        {
+            Thread.currentThread().interrupt();
+            throw new IllegalStateException(ex);
+        }
+    }
+
+    private static int counterId(final CountersReader counters, final int clusterId, final int typeId)
+    {
+        final int[] found = { CountersReader.NULL_COUNTER_ID };
+        counters.forEach((counterId, type, keyBuffer, label) ->
+        {
+            if (CountersReader.NULL_COUNTER_ID == found[0] && type == typeId && keyBuffer.getInt(0) == clusterId)
+            {
+                found[0] = counterId;
+            }
+        });
+        return found[0];
+    }
+
+    private void find(
+        final CountersReader reader, final int clusterId, final int typeId, final Consumer<Counter> setter)
+    {
+        final int counterId = counterId(reader, clusterId, typeId);
+        if (CountersReader.NULL_COUNTER_ID != counterId)
+        {
+            final Counter counter = new Counter(reader, counterId);
+            counters.add(counter);
+            setter.accept(counter);
+        }
+    }
+
+    private static void add(final List<String> command, final String flag, final Object value)
+    {
+        if (null != value)
+        {
+            command.add(flag);
+            command.add(value.toString());
+        }
+    }
+
+    private static void addNs(final List<String> command, final String flag, final long valueNs)
+    {
+        add(command, flag, valueNs + "ns");
+    }
+}
