+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package io.aeron.test.cluster;
+
+import io.aeron.AeronCounters;
+import io.aeron.Counter;
+import io.aeron.cluster.ClusterBackup;
+import io.aeron.cluster.service.ClusterMarkFile;
+import io.aeron.security.CredentialsSupplier;
+import org.agrona.CloseHelper;
+import org.agrona.IoUtil;
+import org.agrona.concurrent.AtomicBuffer;
+import org.agrona.concurrent.SystemEpochClock;
+import org.agrona.concurrent.status.AtomicCounter;
+import org.agrona.concurrent.status.CountersReader;
+
+import java.io.File;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.time.LocalDateTime;
+import java.time.format.DateTimeFormatter;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.function.Consumer;
+
+/**
+ * rusteron's cluster backup, run as a process in place of Java's ClusterBackup when the environment variable
+ * {@code AERON_TEST_RUST_BACKUP} names its binary ({@code cluster_backup}): its settings those the context would
+ * have given Java's, on the backup node's media driver and Java archive, its counters found on the driver and set on
+ * the context for the tests to read, its error log read from its mark file. A credentials supplier is passed as what
+ * it gives: its encoded credentials, and its answer to a challenge (the test suppliers' answers do not depend on the
+ * challenge). Its output goes to {@code AERON_TEST_RUST_CM_LOG_DIR} when set, else beside the cluster directory.
+ */
+final class RustBackup implements AutoCloseable
+{
+    static final String BINARY = System.getenv("AERON_TEST_RUST_BACKUP");
+    private static final String LOG_DIR = System.getenv("AERON_TEST_RUST_CM_LOG_DIR");
+    private static final AtomicInteger STARTS = new AtomicInteger();
+
+    private final Process process;
+    private final File log;
+    private final File markFileDir;
+    private final List<Counter> counters = new ArrayList<>();
+    private ClusterMarkFile markFile;
+    private volatile boolean isClosing;
+
+    static boolean isEnabled()
+    {
+        return null != BINARY && !BINARY.isEmpty();
+    }
+
+    RustBackup(final ClusterBackup.Context ctx, final String aeronDirectoryName, final CountersReader countersReader)
+    {
+        final File clusterDir = ctx.clusterDir();
+        markFileDir = null != ctx.markFileDir() ? ctx.markFileDir() : clusterDir;
+        IoUtil.ensureDirectoryExists(clusterDir.getParentFile(), "cluster backup");
+        if (null != LOG_DIR && !LOG_DIR.isEmpty())
+        {
+            IoUtil.ensureDirectoryExists(new File(LOG_DIR), "rust backup logs");
+            log = new File(LOG_DIR, String.format("%s-%03d-backup.log",
+                LocalDateTime.now().format(DateTimeFormatter.ofPattern("HHmmss.SSS")), STARTS.incrementAndGet()));
+        }
+        else
+        {
+            log = new File(clusterDir.getParentFile(), "rust-backup.log");
+        }
+
+        final List<String> command = new ArrayList<>();
+        command.add(BINARY);
+        add(command, "--aeron-dir", aeronDirectoryName);
+        add(command, "--cluster-dir", clusterDir.getAbsolutePath());
+        if (null != ctx.markFileDir())
+        {
+            add(command, "--mark-file-dir", ctx.markFileDir().getAbsolutePath());
+        }
+        if (ctx.deleteDirOnStart())
+        {
+            command.add("--delete-dir-on-start");
+        }
+        add(command, "--cluster-id", ctx.clusterId());
+        add(command, "--consensus-channel", ctx.consensusChannel());
+        add(command, "--consensus-stream-id", ctx.consensusStreamId());
+        add(command, "--cluster-consensus-endpoints", ctx.clusterConsensusEndpoints());
+        add(command, "--log-stream-id", ctx.logStreamId());
+        add(command, "--catchup-endpoint", ctx.catchupEndpoint());
+        add(command, "--catchup-channel", ctx.catchupChannel());
+        addNs(command, "--cluster-backup-interval", ctx.clusterBackupIntervalNs());
+        addNs(command, "--cluster-backup-response-timeout", ctx.clusterBackupResponseTimeoutNs());
+        addNs(command, "--cluster-backup-progress-timeout", ctx.clusterBackupProgressTimeoutNs());
+        addNs(command, "--cluster-backup-cool-down-interval", ctx.clusterBackupCoolDownIntervalNs());
+        addNs(command, "--replication-progress-timeout", ctx.replicationProgressTimeoutNs());
+        if (ctx.replicationProgressIntervalNs() > 0)
+        {
+            addNs(command, "--replication-progress-interval", ctx.replicationProgressIntervalNs());
+        }
+        add(command, "--source-type", ctx.sourceType().name());
+        if (null != ctx.initialReplayStart())
+        {
+            add(command, "--initial-replay-start", ctx.initialReplayStart().name());
+        }
+        add(command, "--archive-control-request-channel", ctx.archiveContext().controlRequestChannel());
+        add(command, "--archive-control-request-stream-id", ctx.archiveContext().controlRequestStreamId());
+        add(command, "--archive-control-response-channel", ctx.archiveContext().controlResponseChannel());
+        add(command, "--archive-control-response-stream-id", ctx.archiveContext().controlResponseStreamId());
+        add(command, "--cluster-archive-control-request-channel", ctx.clusterArchiveContext().controlRequestChannel());
+        add(command, "--cluster-archive-control-request-stream-id",
+            ctx.clusterArchiveContext().controlRequestStreamId());
+        add(command, "--cluster-archive-control-response-channel",
+            ctx.clusterArchiveContext().controlResponseChannel());
+        add(command, "--cluster-archive-control-response-stream-id",
+            ctx.clusterArchiveContext().controlResponseStreamId());
+        add(command, "--error-buffer-length", ctx.errorBufferLength());
+        final CredentialsSupplier credentials = ctx.credentialsSupplier();
+        if (null != credentials)
+        {
+            final byte[] encoded = credentials.encodedCredentials();
+            if (null != encoded && encoded.length > 0)
+            {
+                add(command, "--credentials", new String(encoded, StandardCharsets.US_ASCII));
+            }
+            final byte[] answer = credentials.onChallenge(new byte[0]);
+            if (null != answer && answer.length > 0)
+            {
+                add(command, "--challenge-response", new String(answer, StandardCharsets.US_ASCII));
+            }
+        }
+
+        try
+        {
+            process = new ProcessBuilder(command)
+                .redirectErrorStream(true)
+                .redirectOutput(ProcessBuilder.Redirect.appendTo(log))
+                .start();
+            awaitReady();
+        }
+        catch (final IOException ex)
+        {
+            throw new IllegalStateException("cannot start " + BINARY, ex);
+        }
+
+        // Its counters are on the driver once it printed READY: it allocates them before.
+        final int clusterId = ctx.clusterId();
+        final long deadlineNs = System.nanoTime() + TimeUnit.SECONDS.toNanos(10);
+        while (counterId(countersReader, clusterId, AeronCounters.CLUSTER_BACKUP_STATE_TYPE_ID) < 0 ||
+            counterId(countersReader, clusterId, AeronCounters.CLUSTER_BACKUP_SNAPSHOT_RETRIEVE_COUNT_TYPE_ID) < 0)
+        {
+            if (System.nanoTime() > deadlineNs || !process.isAlive())
+            {
+                throw new IllegalStateException("rust backup's counters not found, see " + log);
+            }
+            sleep();
+        }
+        find(countersReader, clusterId, AeronCounters.CLUSTER_BACKUP_STATE_TYPE_ID, ctx::stateCounter);
+        find(countersReader, clusterId, AeronCounters.CLUSTER_BACKUP_LIVE_LOG_POSITION_TYPE_ID,
+            ctx::liveLogPositionCounter);
+        find(countersReader, clusterId, AeronCounters.CLUSTER_BACKUP_QUERY_DEADLINE_TYPE_ID,
+            ctx::nextQueryDeadlineMsCounter);
+        find(countersReader, clusterId, AeronCounters.CLUSTER_BACKUP_SNAPSHOT_RETRIEVE_COUNT_TYPE_ID,
+            ctx::snapshotRetrieveCounter);
+        final int errors = counterId(countersReader, clusterId, AeronCounters.CLUSTER_BACKUP_ERROR_COUNT_TYPE_ID);
+        ctx.errorCounter(new AtomicCounter(countersReader.valuesBuffer(), errors));
+        if (null == ctx.epochClock())
+        {
+            ctx.epochClock(SystemEpochClock.INSTANCE);
+        }
+
+        // Ended on its own, as Java's agent terminates: its counters close, as Java's context closes them.
+        process.onExit().thenRun(() ->
+        {
+            if (!isClosing)
+            {
+                counters.forEach(Counter::close);
+            }
+        });
+    }
+
+    /**
+     * The backup's error log, in its mark file.
+     */
+    AtomicBuffer errorLog()
+    {
+        if (null == markFile)
+        {
+            markFile = new ClusterMarkFile(
+                markFileDir, ClusterMarkFile.FILENAME, SystemEpochClock.INSTANCE, 0, (s) -> {});
+        }
+        return markFile.errorBuffer();
+    }
+
+    /**
+     * Stops the process as Java's close stops its agent: SIGTERM, on which it stops its recording and replay and
+     * closes its mark file. Its counters are closed, as Java's context closes them.
+     */
+    public void close()
+    {
+        isClosing = true;
+        counters.forEach(Counter::close);
+        process.destroy();
+        try
+        {
+            if (!process.waitFor(10, TimeUnit.SECONDS))
+            {
+                process.destroyForcibly();
+                process.waitFor(10, TimeUnit.SECONDS);
+            }
+        }
+        catch (final InterruptedException ex)
+        {
+            Thread.currentThread().interrupt();
+        }
+        CloseHelper.quietClose(markFile);
+    }
+
+    private void awaitReady() throws IOException
+    {
+        final long deadlineNs = System.nanoTime() + TimeUnit.SECONDS.toNanos(30);
+        while (System.nanoTime() < deadlineNs)
+        {
+            final String output = log.exists() ? Files.readString(log.toPath()) : "";
+            if (output.contains("READY"))
+            {
+                return;
+            }
+            if (!process.isAlive())
+            {
+                throw new IllegalStateException("rust backup exited " + process.exitValue() + ": " + output);
+            }
+            sleep();
+        }
+        throw new IllegalStateException("rust backup not ready, see " + log);
+    }
+
+    private static void sleep()
+    {
+        try
+        {
+            Thread.sleep(10);
+        }
+        catch (final InterruptedException ex)
+        {
+            Thread.currentThread().interrupt();
+            throw new IllegalStateException(ex);
+        }
+    }
+
+    private static int counterId(final CountersReader counters, final int clusterId, final int typeId)
+    {
+        final int[] found = { CountersReader.NULL_COUNTER_ID };
+        counters.forEach((counterId, type, keyBuffer, label) ->
+        {
+            if (CountersReader.NULL_COUNTER_ID == found[0] && type == typeId && keyBuffer.getInt(0) == clusterId)
+            {
+                found[0] = counterId;
+            }
+        });
+        return found[0];
+    }
+
+    private void find(
+        final CountersReader reader, final int clusterId, final int typeId, final Consumer<Counter> setter)
+    {
+        final int counterId = counterId(reader, clusterId, typeId);
+        if (CountersReader.NULL_COUNTER_ID != counterId)
+        {
+            final Counter counter = new Counter(reader, counterId);
+            counters.add(counter);
+            setter.accept(counter);
+        }
+    }
+
+    private static void add(final List<String> command, final String flag, final Object value)
+    {
+        if (null != value)
+        {
+            command.add(flag);
+            command.add(value.toString());
+        }
+    }
+
+    private static void addNs(final List<String> command, final String flag, final long valueNs)
+    {
+        add(command, flag, valueNs + "ns");
+    }
+}
diff -ruN orig/aeron-test-support/src/main/java/io/aeron/test/cluster/RustClient.java new/aeron-test-support/src/main/java/io/aeron/test/cluster/RustClient.java
