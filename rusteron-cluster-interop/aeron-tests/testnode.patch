+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package io.aeron.test.cluster;
+
+import io.aeron.cluster.client.ClusterException;
+import io.aeron.cluster.client.EgressListener;
+import io.aeron.cluster.codecs.AdminRequestType;
+import io.aeron.cluster.codecs.AdminResponseCode;
+import io.aeron.cluster.codecs.EventCode;
+import io.aeron.exceptions.TimeoutException;
+import io.aeron.security.AuthenticationException;
+import org.agrona.DirectBuffer;
+import org.agrona.concurrent.UnsafeBuffer;
+
+import java.io.BufferedReader;
+import java.io.IOException;
+import java.io.InputStreamReader;
+import java.io.PrintWriter;
+import java.io.UncheckedIOException;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.TimeUnit;
+
+/**
+ * rusteron's cluster client, in a process of its own (the {@code client_lines} binary that
+ * {@code AERON_TEST_RUST_CLIENT} names), as a Java test drives Aeron's {@code AeronCluster}: connect, offer,
+ * keepalive, admin request, poll the egress into an {@link EgressListener}, close. It attaches to the media driver
+ * whose directory it is given, the test cluster's client driver.
+ */
+public final class RustClient implements AutoCloseable
+{
+    static final String BINARY = System.getenv("AERON_TEST_RUST_CLIENT");
+
+    /**
+     * An offer refused for the message itself, too long for instance: Aeron C's {@code AERON_PUBLICATION_ERROR},
+     * where Java's {@code AeronCluster.offer} throws.
+     */
+    public static final long PUBLICATION_ERROR = -6;
+
+    private final Process process;
+    private final PrintWriter in;
+    private final BufferedReader out;
+    private long clusterSessionId;
+    private int leaderMemberId;
+    private long leadershipTermId;
+    private String state = "Connected";
+
+    /**
+     * What a test sets: Java's {@code AeronCluster.Context}, as far as the Rust client takes it.
+     */
+    public static final class Context
+    {
+        String aeronDirectoryName;
+        String ingressChannel;
+        String ingressEndpoints;
+        String egressChannel;
+        long messageTimeoutNs = TimeUnit.SECONDS.toNanos(5);
+        long newLeaderTimeoutNs = -1;
+        byte[] credentials;
+        byte[] challengeResponse;
+
+        public Context aeronDirectoryName(final String aeronDirectoryName)
+        {
+            this.aeronDirectoryName = aeronDirectoryName;
+            return this;
+        }
+
+        public Context ingressChannel(final String ingressChannel)
+        {
+            this.ingressChannel = ingressChannel;
+            return this;
+        }
+
+        public Context ingressEndpoints(final String ingressEndpoints)
+        {
+            this.ingressEndpoints = ingressEndpoints;
+            return this;
+        }
+
+        public Context egressChannel(final String egressChannel)
+        {
+            this.egressChannel = egressChannel;
+            return this;
+        }
+
+        public Context messageTimeoutNs(final long messageTimeoutNs)
+        {
+            this.messageTimeoutNs = messageTimeoutNs;
+            return this;
+        }
+
+        public Context newLeaderTimeoutNs(final long newLeaderTimeoutNs)
+        {
+            this.newLeaderTimeoutNs = newLeaderTimeoutNs;
+            return this;
+        }
+
+        public Context credentials(final byte[] credentials, final byte[] challengeResponse)
+        {
+            this.credentials = credentials;
+            this.challengeResponse = challengeResponse;
+            return this;
+        }
+    }
+
+    private RustClient() throws IOException
+    {
+        if (null == BINARY)
+        {
+            throw new IllegalStateException("AERON_TEST_RUST_CLIENT names no client binary");
+        }
+        process = new ProcessBuilder(BINARY).redirectError(ProcessBuilder.Redirect.INHERIT).start();
+        in = new PrintWriter(process.getOutputStream(), true, StandardCharsets.US_ASCII);
+        out = new BufferedReader(new InputStreamReader(process.getInputStream(), StandardCharsets.US_ASCII));
+    }
+
+    /**
+     * Opens a session, as {@code AeronCluster.connect} does, throwing what it throws.
+     */
+    public static RustClient connect(final Context ctx)
+    {
+        final RustClient client;
+        try
+        {
+            client = new RustClient();
+        }
+        catch (final IOException ex)
+        {
+            throw new UncheckedIOException(ex);
+        }
+        final String answer = client.request(
+            "connect aeron_dir=" + ctx.aeronDirectoryName +
+            " ingress_channel=" + ctx.ingressChannel +
+            " ingress_endpoints=" + (null == ctx.ingressEndpoints ? "-" : ctx.ingressEndpoints) +
+            " egress_channel=" + ctx.egressChannel +
+            " message_timeout_ms=" + TimeUnit.NANOSECONDS.toMillis(ctx.messageTimeoutNs) +
+            " new_leader_timeout_ms=" +
+            (ctx.newLeaderTimeoutNs < 0 ? -1 : TimeUnit.NANOSECONDS.toMillis(ctx.newLeaderTimeoutNs)) +
+            " credentials=" + hex(ctx.credentials) +
+            " challenge_response=" + hex(ctx.challengeResponse)).get(0);
+        if (answer.startsWith("error "))
+        {
+            client.close();
+            throw exception(answer);
+        }
+        final String[] words = answer.split(" ");
+        client.clusterSessionId = Long.parseLong(words[1]);
+        client.leaderMemberId = Integer.parseInt(words[2]);
+        client.leadershipTermId = Long.parseLong(words[3]);
+        return client;
+    }
+
+    public long clusterSessionId()
+    {
+        return clusterSessionId;
+    }
+
+    public int leaderMemberId()
+    {
+        return leaderMemberId;
+    }
+
+    public long leadershipTermId()
+    {
+        return leadershipTermId;
+    }
+
+    public boolean isClosed()
+    {
+        return "Closed".equals(state);
+    }
+
+    /**
+     * The client's state, {@code AeronCluster.State}'s names in the Rust client's spelling.
+     */
+    public String state()
+    {
+        return state;
+    }
+
+    /**
+     * The leader's ingress publication's channel, or null with none.
+     */
+    public String ingressChannel()
+    {
+        final String[] words = request("state").get(0).split(" ");
+        state = words[1];
+        return "-".equals(words[5]) ? null : words[5];
+    }
+
+    public long offer(final DirectBuffer buffer, final int offset, final int length)
+    {
+        final byte[] bytes = new byte[length];
+        buffer.getBytes(offset, bytes);
+        return Long.parseLong(request("offer " + hex(bytes)).get(0).split(" ")[1]);
+    }
+
+    public boolean sendKeepAlive()
+    {
+        return yesNo(request("keepalive").get(0));
+    }
+
+    public boolean sendAdminRequestToTakeASnapshot(final long correlationId)
+    {
+        return yesNo(request("admin " + correlationId).get(0));
+    }
+
+    /**
+     * Polls the egress once, its callbacks made on {@code listener}: the work done.
+     */
+    public int pollEgress(final EgressListener listener)
+    {
+        int work = 0;
+        for (final String line : request("poll"))
+        {
+            final String[] w = line.split(" ", -1);
+            switch (w[0])
+            {
+                case "message":
+                {
+                    final byte[] payload = unhex(w[3]);
+                    listener.onMessage(
+                        Long.parseLong(w[1]), Long.parseLong(w[2]), new UnsafeBuffer(payload), 0, payload.length, null);
+                    break;
+                }
+                case "event":
+                    listener.onSessionEvent(
+                        Long.parseLong(w[1]),
+                        Long.parseLong(w[2]),
+                        Long.parseLong(w[3]),
+                        Integer.parseInt(w[4]),
+                        "NullVal".equals(w[5]) ? EventCode.NULL_VAL : EventCode.valueOf(w[5]),
+                        new String(unhex(w[6]), StandardCharsets.US_ASCII));
+                    break;
+                case "new-leader":
+                    leadershipTermId = Long.parseLong(w[2]);
+                    leaderMemberId = Integer.parseInt(w[3]);
+                    listener.onNewLeader(
+                        Long.parseLong(w[1]), leadershipTermId, leaderMemberId, "-".equals(w[4]) ? "" : w[4]);
+                    break;
+                case "admin-response":
+                {
+                    final byte[] payload = unhex(w[6]);
+                    listener.onAdminResponse(
+                        Long.parseLong(w[1]),
+                        Long.parseLong(w[2]),
+                        AdminRequestType.valueOf(w[3]),
+                        AdminResponseCode.valueOf(w[4]),
+                        new String(unhex(w[5]), StandardCharsets.US_ASCII),
+                        new UnsafeBuffer(payload),
+                        0,
+                        payload.length);
+                    break;
+                }
+                case "polled":
+                    work = Integer.parseInt(w[1]);
+                    state = w[2];
+                    break;
+                case "error":
+                    throw exception(line);
+                default:
+                    throw new IllegalStateException("unexpected line from the Rust client: " + line);
+            }
+        }
+        return work;
+    }
+
+    public void close()
+    {
+        if (process.isAlive())
+        {
+            in.println("close");
+            in.println("quit");
+            try
+            {
+                if (!process.waitFor(10, TimeUnit.SECONDS))
+                {
+                    process.destroyForcibly();
+                }
+            }
+            catch (final InterruptedException ex)
+            {
+                Thread.currentThread().interrupt();
+                process.destroyForcibly();
+            }
+        }
+        state = "Closed";
+    }
+
+    /**
+     * Sends a command, and reads its answer: the lines up to its last one.
+     */
+    private List<String> request(final String command)
+    {
+        in.println(command);
+        final List<String> lines = new ArrayList<>();
+        final String last = command.split(" ")[0];
+        try
+        {
+            while (true)
+            {
+                final String line = out.readLine();
+                if (null == line)
+                {
+                    throw new IllegalStateException("the Rust client exited during: " + last);
+                }
+                lines.add(line);
+                if (isLast(last, line))
+                {
+                    return lines;
+                }
+            }
+        }
+        catch (final IOException ex)
+        {
+            throw new UncheckedIOException(ex);
+        }
+    }
+
+    private static boolean isLast(final String command, final String line)
+    {
+        if (line.startsWith("error "))
+        {
+            return true;
+        }
+        switch (command)
+        {
+            case "poll":
+                return line.startsWith("polled ");
+            case "connect":
+                return line.startsWith("connected ");
+            case "close":
+                return line.equals("closed");
+            default:
+                return line.startsWith(command + " ");
+        }
+    }
+
+    private boolean yesNo(final String line)
+    {
+        if (line.startsWith("error "))
+        {
+            throw exception(line);
+        }
+        return Boolean.parseBoolean(line.split(" ")[1]);
+    }
+
+    private static RuntimeException exception(final String line)
+    {
+        final String[] w = line.split(" ", 3);
+        final String message = w.length > 2 ? new String(unhex(w[2]), StandardCharsets.US_ASCII) : "";
+        switch (w[1])
+        {
+            case "timeout":
+                return new TimeoutException(message);
+            case "authentication":
+                return new AuthenticationException(message);
+            default:
+                return new ClusterException(message);
+        }
+    }
+
+    private static String hex(final byte[] bytes)
+    {
+        if (null == bytes || 0 == bytes.length)
+        {
+            return "-";
+        }
+        final StringBuilder sb = new StringBuilder();
+        for (final byte b : bytes)
+        {
+            sb.append(String.format("%02x", b & 0xff));
+        }
+        return sb.toString();
+    }
+
+    private static byte[] unhex(final String text)
+    {
+        if ("-".equals(text) || text.isEmpty())
+        {
+            return new byte[0];
+        }
+        final byte[] bytes = new byte[text.length() / 2];
+        for (int i = 0; i < bytes.length; i++)
+        {
+            bytes[i] = (byte)Integer.parseInt(text.substring(2 * i, 2 * i + 2), 16);
+        }
+        return bytes;
+    }
+}
