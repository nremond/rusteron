+    /**
+     * An authenticator as {@code AuthenticationTest}'s: it takes {@code credentials}, or, with a
+     * {@code challenge}, takes them in answer to it; or rejects.
+     */
+    static final class TestAuthenticator implements Authenticator
+    {
+        private final byte[] credentials;
+        private final byte[] challenge;
+        private final boolean reject;
+        private final java.util.Map<Long, Boolean> answered = new java.util.HashMap<>();
+        private final java.util.Map<Long, Boolean> valid = new java.util.HashMap<>();
+
+        TestAuthenticator(final byte[] credentials, final byte[] challenge, final boolean reject)
+        {
+            this.credentials = credentials;
+            this.challenge = challenge;
+            this.reject = reject;
+        }
+
+        public void onConnectRequest(final long sessionId, final byte[] encodedCredentials, final long nowMs)
+        {
+            valid.put(sessionId, Arrays.equals(credentials, encodedCredentials));
+        }
+
+        public void onChallengeResponse(final long sessionId, final byte[] encodedCredentials, final long nowMs)
+        {
+            answered.put(sessionId, true);
+            valid.put(sessionId, Arrays.equals(credentials, encodedCredentials));
+        }
+
+        public void onConnectedSession(final SessionProxy sessionProxy, final long nowMs)
+        {
+            if (null != challenge)
+            {
+                sessionProxy.challenge(challenge);
+            }
+            else if (reject || !valid.getOrDefault(sessionProxy.sessionId(), false))
+            {
+                sessionProxy.reject();
+            }
+            else
+            {
+                sessionProxy.authenticate("principal".getBytes(StandardCharsets.US_ASCII));
+            }
+        }
+
+        public void onChallengedSession(final SessionProxy sessionProxy, final long nowMs)
+        {
+            if (answered.getOrDefault(sessionProxy.sessionId(), false))
+            {
+                if (reject || !valid.getOrDefault(sessionProxy.sessionId(), false))
+                {
+                    sessionProxy.reject();
+                }
+                else
+                {
+                    sessionProxy.authenticate("principal".getBytes(StandardCharsets.US_ASCII));
+                }
+            }
+        }
+    }
+
+    private static final byte[] CREDENTIALS =
+        "username=\"admin\"|password=\"secret\"".getBytes(StandardCharsets.US_ASCII);
+    private static final byte[] CHALLENGE = "I challenge you!".getBytes(StandardCharsets.US_ASCII);
+
+    private void startAuthenticatingCluster(final byte[] challenge, final boolean reject)
+    {
+        assumeTrue(onJavaModules(), "rusteron's module has no authenticator but the default");
+        cluster = aCluster().withStaticNodes(3)
+            .withAuthenticationSupplier(() -> new TestAuthenticator(CREDENTIALS, challenge, reject))
+            .start();
+        systemTestWatcher.cluster(cluster);
+        cluster.awaitLeader();
+    }
+
+    @Test
+    @InterruptAfter(20)
+    void shouldAuthenticateOnConnectRequestWithCredentials()
+    {
+        startAuthenticatingCluster(null, false);
+        final RustClient client = connect(clientCtx().credentials(CREDENTIALS, null));
+        sendAndAwaitEchoes(client, new Heard(), 0, 1);
+    }
+
+    @Test
+    @InterruptAfter(20)
+    void shouldAuthenticateOnChallengeResponse()
+    {
+        startAuthenticatingCluster(CHALLENGE, false);
+        final RustClient client = connect(clientCtx().credentials(new byte[0], CREDENTIALS));
+        sendAndAwaitEchoes(client, new Heard(), 0, 1);
+    }
+
+    @Test
+    @InterruptAfter(20)
+    void shouldRejectOnConnectRequest()
+    {
+        startAuthenticatingCluster(null, true);
+        assertThrows(AuthenticationException.class, () -> connect(clientCtx().credentials(CREDENTIALS, null)));
+    }
+
+    @Test
+    @InterruptAfter(20)
+    void shouldRejectOnChallengeResponse()
+    {
+        startAuthenticatingCluster(CHALLENGE, true);
+        assertThrows(
+            AuthenticationException.class, () -> connect(clientCtx().credentials(new byte[0], CREDENTIALS)));
+    }
+
+    @Test
+    @InterruptAfter(20)
+    void shouldRejectWrongCredentials()
+    {
+        startAuthenticatingCluster(null, false);
+        assertThrows(
+            AuthenticationException.class,
+            () -> connect(clientCtx().credentials("wrong".getBytes(StandardCharsets.US_ASCII), null)));
+    }
+}
