+    @Test
+    @InterruptAfter(10)
+    void shouldNotRejoinItsEgressImageAfterLoss()
+    {
+        TestMediaDriver.notSupportedOnCMediaDriver("uses custom channel endpoint suppliers for simulating loss");
+
+        cluster = aCluster()
+            .withStaticNodes(1)
+            .withServiceSupplier((index) -> new TestNode.TestService[]
+            {
+                new ClusterSessionReliabilityTest.SequencedEgressService(index)
+            })
+            .start();
+        systemTestWatcher.cluster(cluster);
+        cluster.awaitLeader();
+
+        final StreamIdLossGenerator clientReceiveLossGenerator = new StreamIdLossGenerator();
+        cluster.clientReceiveChannelEndpointSupplier((udpChannel, dispatcher, statusIndicator, context) ->
+            new DebugReceiveChannelEndpoint(
+                udpChannel,
+                dispatcher,
+                statusIndicator,
+                context,
+                clientReceiveLossGenerator,
+                clientReceiveLossGenerator));
+        final long imageLivenessTimeoutNs = TimeUnit.MILLISECONDS.toNanos(1000);
+        cluster.clientImageLivenessTimeoutNs(imageLivenessTimeoutNs);
+        final RustClient client = connect(clientCtx());
+
+        final ClusterSessionReliabilityTest.SequenceCheckingEgressListener egressListener =
+            new ClusterSessionReliabilityTest.SequenceCheckingEgressListener();
+        boolean lossRequested = false;
+        final long deadline = System.nanoTime() + imageLivenessTimeoutNs + TimeUnit.SECONDS.toNanos(2);
+        while (System.nanoTime() - deadline < 0)
+        {
+            client.pollEgress(egressListener);
+            if (!lossRequested && egressListener.nextSequence >= 5)
+            {
+                lossRequested = true;
+                clientReceiveLossGenerator.enable(cluster.clientCtx().egressStreamId());
+            }
+
+            Tests.sleep(1);
+        }
+
+        clientReceiveLossGenerator.disable();
+        assertTrue(lossRequested);
+        assertEquals(0, egressListener.outOfSequenceCount);
+    }
