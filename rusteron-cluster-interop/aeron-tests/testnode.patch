+/**
+ * Aeron's client cases, from {@code ClusterTest}, {@code AuthenticationTest} and
+ * {@code ClusterSessionReliabilityTest}, with rusteron's client ({@link RustClient}) in place of Java's
+ * {@code AeronCluster}: on Java's consensus modules, and on rusteron's when {@code AERON_TEST_RUST_CM} names one.
+ * The cluster's services echo what a client sends.
+ */
+@SlowTest
+@ExtendWith({ EventLogExtension.class, InterruptingTestCallback.class })
+class RustClientTest
+{
+    @RegisterExtension
+    final SystemTestWatcher systemTestWatcher = new SystemTestWatcher();
+
+    private TestCluster cluster;
+    private final List<RustClient> clients = new ArrayList<>();
+
+    @AfterEach
+    void after()
+    {
+        clients.forEach(CloseHelper::close);
+    }
+
+    /**
+     * What a client heard.
+     */
+    static final class Heard implements EgressListener
+    {
+        final List<byte[]> messages = new ArrayList<>();
+        final List<Long> sessions = new ArrayList<>();
+        final List<EventCode> events = new ArrayList<>();
+        final List<Integer> newLeaders = new ArrayList<>();
+        final List<String> adminResponses = new ArrayList<>();
+
+        public void onMessage(
+            final long clusterSessionId,
+            final long timestamp,
+            final DirectBuffer buffer,
+            final int offset,
+            final int length,
+            final Header header)
+        {
+            final byte[] bytes = new byte[length];
+            buffer.getBytes(offset, bytes);
+            messages.add(bytes);
+            sessions.add(clusterSessionId);
+        }
+
+        public void onSessionEvent(
+            final long correlationId,
+            final long clusterSessionId,
+            final long leadershipTermId,
+            final int leaderMemberId,
+            final EventCode code,
+            final String detail)
+        {
+            events.add(code);
+        }
+
+        public void onNewLeader(
+            final long clusterSessionId,
+            final long leadershipTermId,
+            final int leaderMemberId,
+            final String ingressEndpoints)
+        {
+            newLeaders.add(leaderMemberId);
+        }
+
+        public void onAdminResponse(
+            final long clusterSessionId,
+            final long correlationId,
+            final AdminRequestType requestType,
+            final AdminResponseCode responseCode,
+            final String message,
+            final DirectBuffer payload,
+            final int payloadOffset,
+            final int payloadLength)
+        {
+            adminResponses.add(correlationId + " " + requestType + " " + responseCode + " " + message);
+        }
+    }
+
+    private static boolean onJavaModules()
+    {
+        final String rustModule = System.getenv("AERON_TEST_RUST_CM");
+        return null == rustModule || rustModule.isEmpty();
+    }
+
+    private RustClient.Context clientCtx()
+    {
+        final TestMediaDriver driver = cluster.startClientMediaDriver();
+        final AeronCluster.Context java = cluster.clientCtx();
+        return new RustClient.Context()
+            .aeronDirectoryName(driver.aeronDirectoryName())
+            .ingressChannel(java.ingressChannel())
+            .ingressEndpoints(java.ingressEndpoints())
+            .egressChannel(java.egressChannel());
+    }
+
+    private RustClient connect(final RustClient.Context ctx)
+    {
+        final RustClient client = RustClient.connect(ctx);
+        clients.add(client);
+        return client;
+    }
+
+    private static byte[] message(final int value)
+    {
+        return ("message " + value).getBytes(StandardCharsets.US_ASCII);
+    }
+
+    private static void send(final RustClient client, final Heard heard, final byte[] message)
+    {
+        final UnsafeBuffer buffer = new UnsafeBuffer(message);
+        while (client.offer(buffer, 0, message.length) < 0)
+        {
+            client.pollEgress(heard);
+            Tests.yield();
+        }
+    }
+
+    private static void awaitEchoes(final RustClient client, final Heard heard, final int count)
+    {
+        while (heard.messages.size() < count)
+        {
+            if (0 == client.pollEgress(heard))
+            {
+                Tests.yield();
+            }
+        }
+    }
+
+    private static void sendAndAwaitEchoes(final RustClient client, final Heard heard, final int from, final int to)
+    {
+        final int before = heard.messages.size();
+        for (int i = from; i < to; i++)
+        {
+            send(client, heard, message(i));
+        }
+        awaitEchoes(client, heard, before + to - from);
+        for (int i = from; i < to; i++)
+        {
+            assertArrayEquals(message(i), heard.messages.get(before + i - from));
+        }
+    }
+
+    /**
+     * {@code TestCluster.awaitServiceMessageCount} without its keepalives, which are sent by Java's client.
+     */
+    private static void awaitServiceMessageCount(final TestNode node, final int count)
+    {
+        while (node.service().messageCount() < count)
+        {
+            Tests.yield();
+        }
+    }
+
+    private static String endpointOf(final String channel)
+    {
+        return ChannelUri.parse(channel).get(ENDPOINT_PARAM_NAME);
+    }
+
+    private static int endpointPort(final String channel)
+    {
+        final String endpoint = endpointOf(channel);
+        return Integer.parseInt(endpoint.substring(endpoint.indexOf(':') + 1));
+    }
+
+    @Test
+    @InterruptAfter(30)
+    void shouldConnectEchoAndClose()
+    {
+        cluster = aCluster().withStaticNodes(3).start();
+        systemTestWatcher.cluster(cluster);
+        final TestNode leader = cluster.awaitLeader();
+
+        final RustClient client = connect(clientCtx());
+        assertEquals(leader.index(), client.leaderMemberId());
+        cluster.awaitActiveSessionCount(1);
+        final Heard heard = new Heard();
+        sendAndAwaitEchoes(client, heard, 0, 10);
+        assertTrue(heard.sessions.stream().allMatch(s -> s == client.clusterSessionId()));
+
+        client.close();
+        cluster.awaitActiveSessionCount(0);
+    }
+
