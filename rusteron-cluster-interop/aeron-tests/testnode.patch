+package io.aeron.cluster;
+
+import io.aeron.Aeron;
+import io.aeron.Publication;
+import io.aeron.Subscription;
+import io.aeron.cluster.client.AeronCluster;
+import io.aeron.cluster.codecs.MessageHeaderEncoder;
+import io.aeron.cluster.codecs.StandbySnapshotEncoder;
+import io.aeron.test.EventLogExtension;
+import io.aeron.test.InterruptAfter;
+import io.aeron.test.InterruptingTestCallback;
+import io.aeron.test.SlowTest;
+import io.aeron.test.SystemTestWatcher;
+import io.aeron.test.Tests;
+import io.aeron.test.cluster.TestCluster;
+import io.aeron.test.cluster.TestNode;
+import org.agrona.ExpandableArrayBuffer;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.extension.ExtendWith;
+import org.junit.jupiter.api.extension.RegisterExtension;
+
+import java.util.List;
+
+import static io.aeron.test.cluster.TestCluster.aCluster;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/**
+ * A member restarting from a standby's snapshot: a follower that missed the cluster's snapshot is told of one, as
+ * a standby tells the members of its own, its recordings in the leader's archive; at its next start it copies them
+ * into its own archive and loads them. Open-source Aeron sends no such notice itself: the test sends it as a
+ * standby would. It runs on Java's consensus modules and on rusteron's alike.
+ */
+@SlowTest
+@ExtendWith({ EventLogExtension.class, InterruptingTestCallback.class })
+class StandbySnapshotNoticeTest
+{
+    private static final int RESPONSE_STREAM_ID = 29877;
+
+    @RegisterExtension
+    final SystemTestWatcher systemTestWatcher = new SystemTestWatcher();
+
+    @Test
+    @InterruptAfter(60)
+    void shouldRestartFromStandbySnapshotCopiedFromAnotherArchive()
+    {
+        final TestCluster cluster = aCluster().withStaticNodes(3).withStandbySnapshots(true).start();
+        systemTestWatcher.cluster(cluster);
+        final TestNode leader = cluster.awaitLeader();
+        final int followerIndex = cluster.followers().get(0).index();
+
+        final AeronCluster client = cluster.connectClient();
+        cluster.sendAndAwaitMessages(10);
+
+        cluster.stopNode(cluster.node(followerIndex));
+        cluster.takeSnapshot(leader);
+        cluster.awaitSnapshotCount(1);
+        cluster.sendAndAwaitMessages(10, 20);
+
+        TestNode follower = cluster.startStaticNode(followerIndex, false);
+        cluster.awaitServiceMessageCount(follower, 20);
+        assertFalse(follower.service().wasSnapshotLoaded(), "the follower missed the snapshot");
+
+        final RecordingLog.Entry module;
+        final RecordingLog.Entry service;
+        try (RecordingLog log = new RecordingLog(leader.consensusModuleContext().clusterDir(), false))
+        {
+            module = log.getLatestSnapshot(ConsensusModule.Configuration.SERVICE_ID);
+            service = log.getLatestSnapshot(0);
+        }
+        assertNotNull(module);
+        assertNotNull(service);
+        final ClusterMember[] members = ClusterMember.parse(leader.consensusModuleContext().clusterMembers());
+        final Aeron aeron = client.context().aeron();
+        try (Subscription responses = aeron.addSubscription("aeron:udp?endpoint=localhost:0", RESPONSE_STREAM_ID);
+            Publication consensus = aeron.addPublication(
+                "aeron:udp?term-length=64k|endpoint=" + members[followerIndex].consensusEndpoint(),
+                ConsensusModule.Configuration.consensusStreamId()))
+        {
+            final String responseChannel = "aeron:udp?endpoint=" + localAddress(responses);
+            final ExpandableArrayBuffer buffer = new ExpandableArrayBuffer(512);
+            final int length = standbySnapshot(
+                buffer,
+                aeron.nextCorrelationId(),
+                responseChannel,
+                members[leader.index()].archiveEndpoint(),
+                List.of(service, module));
+            while (consensus.offer(buffer, 0, length) < 0)
+            {
+                Tests.yield();
+            }
+            cluster.awaitStandbySnapshotCount(follower, 1);
+        }
+
+        cluster.stopNode(follower);
+        follower = cluster.startStaticNode(followerIndex, false);
+        cluster.awaitSnapshotLoadedForService(follower);
+        cluster.awaitServiceMessageCount(follower, 20);
+        assertTrue(follower.service().wasSnapshotLoaded());
+
+        try (RecordingLog log = new RecordingLog(follower.consensusModuleContext().clusterDir(), false))
+        {
+            final RecordingLog.Entry copied = log.getLatestSnapshot(ConsensusModule.Configuration.SERVICE_ID);
+            assertNotNull(copied, "the copy filed as the follower's own snapshot");
+            assertTrue(copied.logPosition == module.logPosition, copied.toString());
+        }
+
+        cluster.sendAndAwaitMessages(10, 30);
+        cluster.awaitServiceMessageCount(follower, 30);
+    }
+
+    private static String localAddress(final Subscription subscription)
+    {
+        while (subscription.localSocketAddresses().isEmpty())
+        {
+            Tests.yield();
+        }
+        return subscription.localSocketAddresses().get(0);
+    }
+
+    private static int standbySnapshot(
+        final ExpandableArrayBuffer buffer,
+        final long correlationId,
+        final String responseChannel,
+        final String archiveEndpoint,
+        final List<RecordingLog.Entry> entries)
+    {
+        final MessageHeaderEncoder header = new MessageHeaderEncoder();
+        final StandbySnapshotEncoder encoder = new StandbySnapshotEncoder()
+            .wrapAndApplyHeader(buffer, 0, header)
+            .correlationId(correlationId)
+            .version(AeronCluster.Configuration.PROTOCOL_SEMANTIC_VERSION)
+            .responseStreamId(RESPONSE_STREAM_ID);
+        final StandbySnapshotEncoder.SnapshotsEncoder snapshots = encoder.snapshotsCount(entries.size());
+        for (final RecordingLog.Entry entry : entries)
+        {
+            snapshots.next()
+                .recordingId(entry.recordingId)
+                .leadershipTermId(entry.leadershipTermId)
+                .termBaseLogPosition(entry.termBaseLogPosition)
+                .logPosition(entry.logPosition)
+                .timestamp(entry.timestamp)
+                .serviceId(entry.serviceId)
+                .archiveEndpoint(archiveEndpoint);
+        }
+        encoder.responseChannel(responseChannel).putEncodedCredentials(new byte[0], 0, 0);
+        return MessageHeaderEncoder.ENCODED_LENGTH + encoder.encodedLength();
+    }
+}
